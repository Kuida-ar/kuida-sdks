{
    "name": "kuida/kuida-php",
    "description": "SDK oficial de Kuida para PHP: pacientes, turnos, consultas, solicitudes de ingreso, tratamientos, eventos y webhooks.",
    "type": "library",
    "keywords": [
        "kuida",
        "api",
        "salud",
        "pacientes",
        "whatsapp",
        "sdk"
    ],
    "homepage": "https://www.kuida.ar/desarrolladores",
    "license": "MIT",
    "authors": [
        {
            "name": "Kuida",
            "email": "desarrolladores@kuida.ar",
            "homepage": "https://www.kuida.ar"
        }
    ],
    "support": {
        "email": "desarrolladores@kuida.ar",
        "issues": "https://github.com/Kuida-ar/kuida-sdks/issues",
        "source": "https://github.com/Kuida-ar/kuida-sdks",
        "docs": "https://www.kuida.ar/desarrolladores"
    },
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.10",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Kuida\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kuida\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "generate": "php scripts/generate.php",
        "analyse": "phpstan analyse --no-progress",
        "compat": "phpcs --standard=phpcs.xml.dist",
        "check": [
            "@compat",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
